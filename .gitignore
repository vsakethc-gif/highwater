node_modules/
# Build output (re-created by "npm run build")
dist/
# Secrets: NEVER commit these
.env
.env.*
!.env.example
.dev.vars
*.key
# Editor / OS clutter
.DS_Store
Thumbs.db
.vscode/
*.log
# Large raw downloads used by scripts (only small processed files get committed)
scripts/raw/

# impeccable design tool: its 19 MB program stays local (reinstall with: npx impeccable install)
.claude/skills/impeccable/scripts/bin/
.github/skills/impeccable/scripts/bin/
